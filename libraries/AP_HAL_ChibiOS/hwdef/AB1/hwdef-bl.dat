# hw definition file for the Align AB1 (M4T40 PCU) bootloader

# MCU class and specific type
MCU STM32L431 STM32L431xx

# crystal frequency
OSCILLATOR_HZ 24000000

# board ID for firmware load
APJ_BOARD_ID 156

# setup build for a peripheral firmware
env AP_PERIPH 1

FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 36
FLASH_SIZE_KB 256

# reserve some space for params
APP_START_OFFSET_KB 4

# LED. PLACEHOLDER: the PCU schematic has no MCU driven LED at all, the
# red LED1 is wired to its own net and never reaches the MCU. PB12 is
# just a free pin, picked because it is the ACT LED on AS1. Check the
# PCB and fix the pin and HAL_LED_ON here and in hwdef.dat before relying
# on the blink codes.
PB12 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1

# CAN
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1
CAN_ORDER 1

# use a small bootloader timeout
define HAL_BOOTLOADER_TIMEOUT 1000

# No serial needed for bootloader (no USB or UART firmware uploader, just use CAN)
define HAL_USE_SERIAL FALSE

define HAL_NO_GPIO_IRQ
define SERIAL_BUFFERS_SIZE 32
define HAL_USE_EMPTY_IO TRUE
define PORT_INT_REQUIRED_STACK 64
define DMA_RESERVE_SIZE 0

MAIN_STACK 0x800
PROCESS_STACK 0x800

define HAL_DISABLE_LOOP_DELAY

# debugger support
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
