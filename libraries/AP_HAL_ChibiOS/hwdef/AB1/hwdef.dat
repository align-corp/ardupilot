# hw definition file for the Align AB1 (M4T40 PCU) L431 CAN node
# PWM outputs plus relay outputs for the lamp rails. No ADC, no I2C,
# no notify LED: the red LED1 on the board is not driven by the MCU.

# MCU class and specific type
MCU STM32L431 STM32L431xx

# bootloader starts firmware at 36k + 4k (STORAGE_FLASH)
FLASH_RESERVE_START_KB 40
FLASH_SIZE_KB 256

# store parameters in pages 18 and 19
STORAGE_FLASH_PAGE 18
define HAL_STORAGE_SIZE 800

# ChibiOS system timer
STM32_ST_USE_TIMER 15
define CH_CFG_ST_RESOLUTION 16

# board ID for firmware load
APJ_BOARD_ID 156

# crystal frequency
OSCILLATOR_HZ 24000000

env AP_PERIPH 1

STDOUT_SERIAL SD2
STDOUT_BAUDRATE 57600

define HAL_NO_GPIO_IRQ
define SERIAL_BUFFERS_SIZE 512
define PORT_INT_REQUIRED_STACK 64

# no analog inputs on this board, and halconf.h defaults HAL_USE_ADC to
# TRUE, which fails to build with no ADC peripheral assigned
define HAL_USE_ADC FALSE

define DMA_RESERVE_SIZE 0

# MAIN_STACK is stack for ISR handlers
MAIN_STACK 0x300

# PROCESS_STACK controls stack for main thread
PROCESS_STACK 0xA00

define HAL_DISABLE_LOOP_DELAY

define HAL_NO_MONITOR_THREAD

# we setup a small defaults.parm
define AP_PARAM_MAX_EMBEDDED_PARAM 512

# LED. PLACEHOLDER: the PCU schematic has no MCU driven LED at all, the
# red LED1 is wired to its own net and never reaches the MCU. PB12 is
# just a free pin, picked because it is the ACT LED on AS1. Check the
# PCB and fix the pin and HAL_LED_ON here and in hwdef-bl.dat before
# relying on the CAN activity blink.
PB12 LED OUTPUT HIGH
define HAL_LED_ON 1

# debugger support
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# CAN, MAX3051 out to CN13 (FCU), CN14 and CN17 (spreader)
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1
CAN_ORDER 1
define HAL_CAN_POOL_SIZE 6000

# UART. USART2 is the only routed port, out to CN16 via FIL2.
# USART1 is on PB6/PB7 but is not wired to anything on this board.
SERIAL_ORDER USART2
PA2 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2 SPEED_HIGH

# PWM, all four are TIM1 so they share one rate group
PA8  TIM1_CH1 TIM1 PWM(1) GPIO(50) # Nozzle, CN9 + CN10
PA9  TIM1_CH2 TIM1 PWM(2) GPIO(51) # PWM2r, CN15
PA10 TIM1_CH3 TIM1 PWM(3) GPIO(52) # PWM3r, CN15
PA11 TIM1_CH4 TIM1 PWM(4) GPIO(53) # Pump, CN11 + CN12
define HAL_PERIPH_ENABLE_RC_OUT

# Relay outputs: enable lines for the two lamp rails. AP_Periph maps
# uavcan.equipment.hardpoint.Command id 0..15 onto RELAYn_FUNCTION
# DroneCAN_HARDPOINT_0 (10) .. DroneCAN_HARDPOINT_15 (25).
PB0 IR_LED_EN OUTPUT LOW GPIO(1) # U1 MP4423C EN, 100W IR LED on CN5
PB1 LED_EN    OUTPUT LOW GPIO(2) # U8+U9 TPS16530 EN, 80W LED on CN6+CN7
define HAL_PERIPH_ENABLE_RELAY
# AP_Periph builds default this to 0, and AP_Periph.h errors without it
define AP_RELAY_ENABLED 1

# TPS16530 fault flags, open drain and active low (100K pullups R30/R31)
PB2 LED1_FLT INPUT PULLUP GPIO(3) # 80W_LED_CH1, CN6
PB3 LED2_FLT INPUT PULLUP GPIO(4) # 80W_LED_CH2, CN7

# allow for reboot command for faster development
define HAL_PERIPH_LISTEN_FOR_SERIAL_UART_REBOOT_CMD_PORT 0

# keep ROMFS uncompressed as we don't have enough RAM
# to uncompress the bootloader at runtime
env ROMFS_UNCOMPRESSED True

# don't embed bootloader
define AP_BOOTLOADER_FLASHING_ENABLED 0
