include ../AP7/hwdef.dat

# define custom Align frame code
define ALIGN_FRAME ALIGN_AP7_M4T40

# decrease arming delay
define ARMING_DELAY_SEC 0.5f

# Telemetry on Serial 1
define DEFAULT_SERIAL1_BAUD 115

# 360 obstacle radar on Serial 2. The protocol (Lidar360) comes from
# AP7/hwdef.dat, only the baud rate is airframe specific.
define DEFAULT_SERIAL2_BAUD 921

# list of files to put in ROMFS (Lua scripts)
ROMFS scripts/rng_auto.lua lua_scr/rng_auto.lua
ROMFS scripts/arm_check.lua lua_scr/arm_check.lua
ROMFS scripts/agricolture_load.lua lua_scr/agricolture_load.lua
ROMFS scripts/batt_cycles.lua lua_scr/batt_cycles.lua
